<mxfile host="app.diagrams.net" version="24.7.17"><diagram id="credit-loop" name="Credit 与 VC 所有权"><mxGraphModel page="1" pageWidth="1040" pageHeight="440"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Credit 与 VC 所有权" style="text;html=1;align=left;fontSize=25;fontStyle=1;fontColor=#16324f;" vertex="1" parent="1"><mxGeometry as="geometry" x="25" y="12" width="990" height="36" /></mxCell><mxCell id="subtitle" value="一个 VC 的教学结构图：槽位许可与报文所有权分别管理。" style="text;html=1;align=left;fontSize=15;fontColor=#52657a;" vertex="1" parent="1"><mxGeometry as="geometry" x="25" y="50" width="990" height="30" /></mxCell><mxCell id="edge0" value="发送" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#52657a;fontSize=13;" edge="1" source="a" target="b" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge1" value="到达" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#52657a;fontSize=13;" edge="1" source="b" target="c" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge2" value="等待 / 出队" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#52657a;fontSize=13;" edge="1" source="c" target="d" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge3" value="资源返回" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#52657a;fontSize=13;dashed=1;" edge="1" source="d" target="e" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge4" value="返回" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#52657a;fontSize=13;dashed=1;" edge="1" source="e" target="f" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge5" value="下一轮许可" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#52657a;fontSize=13;dashed=1;" edge="1" source="f" target="a" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="a" value="上游 OutputUnit&lt;br&gt;c &amp;gt; 0 才有槽位许可" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f1ff;strokeColor=#9bb4cd;fontSize=17;fontColor=#16324f;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="95" width="280" height="90" /></mxCell><mxCell id="b" value="前向 channel&lt;br&gt;Valid flit · VC ID" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f1ff;strokeColor=#9bb4cd;fontSize=17;fontColor=#16324f;" vertex="1" parent="1"><mxGeometry as="geometry" x="380" y="95" width="280" height="90" /></mxCell><mxCell id="c" value="下游 InputBuffer&lt;br&gt;接收并保存 flit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f1ff;strokeColor=#9bb4cd;fontSize=17;fontColor=#16324f;" vertex="1" parent="1"><mxGeometry as="geometry" x="720" y="95" width="280" height="90" /></mxCell><mxCell id="d" value="下游转发 / 出队&lt;br&gt;释放槽位；tail 相关释放" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f5ee;strokeColor=#9bb4cd;fontSize=17;fontColor=#16324f;" vertex="1" parent="1"><mxGeometry as="geometry" x="720" y="285" width="280" height="90" /></mxCell><mxCell id="e" value="反向回传&lt;br&gt;credit_return / vc_free" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f5ee;strokeColor=#9bb4cd;fontSize=17;fontColor=#16324f;" vertex="1" parent="1"><mxGeometry as="geometry" x="380" y="285" width="280" height="90" /></mxCell><mxCell id="f" value="上游状态更新&lt;br&gt;c 返还 · occupied 释放" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f5ee;strokeColor=#9bb4cd;fontSize=17;fontColor=#16324f;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="285" width="280" height="90" /></mxCell></root></mxGraphModel></diagram></mxfile>